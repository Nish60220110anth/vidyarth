{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"Company Knowledge:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textFormat":1,"textStyle":"color: #000000;","tag":"h1"},{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"History & Overview:","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Founded in 1850, headquartered in New York, global financial services center.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"Core Products/Services:","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Premium credit cards, corporate financial services, expense management, global payment networks.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"Customer Segments:","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Affluent consumers, small businesses, corporate clients.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"textStyle":"color: #000000;","value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textFormat":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Key Values & Culture:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textStyle":"color: #000000;","tag":"h2"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Customer-centric mindset.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Premium brand positioning.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Innovation-driven financial technology.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Integrity and regulatory compliance.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textStyle":"color: #000000;","value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"number","start":1,"tag":"ol"}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Inclusivity and diversity in workplace culture.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"number","start":1,"tag":"ol"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Common Interview Topics:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textStyle":"color: #000000;","tag":"h3"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"        ","type":"text","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":2,"format":0,"mode":"normal","style":"color: #000000;","text":"\t","type":"tab","version":1},{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"Behavioral Questions:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textFormat":1,"textStyle":"color: #000000;","tag":"h2"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Describe a time you provided exceptional customer service.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Give an example of how you dealt with a difficult client or team situation.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Share an experience involving teamwork or collaboration.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"    Situational & Problem-solving Questions:","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"heading","version":1,"textFormat":1,"textStyle":"color: #000000;","tag":"h2"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"How would you respond to a customer disputing a charge?","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"How would you handle confidential client information?","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":1,"mode":"normal","style":"color: #000000;","text":"   Technical & Role-specific Questions:","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"heading","version":1,"textFormat":1,"textStyle":"color: #000000;","tag":"h2"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"For analytical roles, discuss experiences with data analysis or financial forecasting.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"For technology roles, prepare for questions about fintech, cybersecurity, digital payments.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Interview Preparation Tips:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textStyle":"color: #000000;","tag":"h3"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Align your answers with Amex’s core values: customer service, integrity, innovation.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Provide clear, structured responses using STAR (Situation, Task, Action, Result).","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Emphasize your ability to handle sensitive financial information responsibly.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Understand Amex’s premium customer base—demonstrate awareness of customer expectations.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":4}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Questions to Ask Interviewer:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textStyle":"color: #000000;","tag":"h3"},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"How does Amex encourage employee development and growth?","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"Can you describe recent initiatives in innovation or digital payments?","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"color: #000000;","text":"How does American Express measure success in this role?","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textStyle":"color: #000000;","value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textStyle":"color: #000000;","listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":"ltr","format":"","indent":0,"type":"root","version":1,"textStyle":"color: #000000;"}}

