{"root":{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"American Express (often shortened to Amex) is a global financial services company best known for its charge and credit card products. Here’s a concise overview:","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Founded & Headquarters","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"heading","version":1,"textFormat":1,"tag":"h2"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Established in 1850, American Express is headquartered in New York City and has grown into one of the world’s largest payment networks.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Core Businesses","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"value":1},{"children":[{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Cards & Payments","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": Offers personal, small-business, and corporate cards—ranging from basic rewards cards up to premium products like The Platinum Card and The Centurion Card.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":1},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Merchant Services","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": Processes transactions for merchants who accept Amex cards.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":2},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Travel & Expense Management","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": Provides booking services, expense-tracking tools, and corporate travel management.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Distinctive Features","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"value":2},{"children":[{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Charge vs. Credit","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": Many Amex products are “charge” cards—requiring full payment each month—while others function like traditional credit cards.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":1},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Membership Rewards","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": A flexible points program that lets cardholders redeem points for travel, statement credits, gift cards, or transfers to airline/hotel partners.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":2},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Premium Benefits","type":"text","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":": Higher-tier cards include lounge access, travel credits, concierge services, and elite hotel status.","type":"text","version":1}],"direction":"ltr","format":"","indent":1,"type":"listitem","version":1,"textFormat":1,"value":3}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Global Reach","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"Amex has a presence in over 130 countries and serves both individual consumers and large corporations. While acceptance historically lagged behind Visa/Mastercard in some markets, Amex continues to expand its merchant network.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"value":3},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Financial Profile","type":"text","version":1},{"type":"linebreak","version":1},{"detail":0,"format":0,"mode":"normal","style":"","text":"It regularly reports annual revenues in the tens of billions of dollars, with a business model that combines interest income (on revolving credit products), card fees, merchant discount fees, and other financial services.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"listitem","version":1,"textFormat":1,"value":4}],"direction":"ltr","format":"","indent":0,"type":"list","version":1,"textFormat":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Overall, American Express distinguishes itself through premium card benefits, a strong rewards ecosystem, and a long-standing reputation in travel and expense management.","type":"text","version":1}],"direction":"ltr","format":"","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""}],"direction":"ltr","format":"","indent":0,"type":"root","version":1,"textFormat":1}}

