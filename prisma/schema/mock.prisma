model userSession {
  id Int @id @default(autoincrement())

  userId Int
  user   user @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  isCvHr Boolean

  companyName String?
  companyId   Int
  company     company @relation("CompanySessions", fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  jdLinks         String
  compendiumLinks String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
