model notification {
  id String @id @default(cuid())

  type      NOTIFICATION_TYPE
  subtype   NOTIFICATION_SUBTYPE?
  initiator NOTIFICATION_SOURCE_INITIATOR

  shortlistId Int?
  shortlist   shortlist? @relation(fields: [shortlistId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  companyId Int?
  company   company? @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  domain DOMAIN?
  round ROUND_TYPE?
  links  notification_link[]

  is_handled Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model notification_link {
  id        Int    @id @default(autoincrement())
  link      String @db.Text
  link_name String

  notificationId String
  notification   notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([notificationId])
}

model notification_properties {
  type NOTIFICATION_TYPE @id

  send_email      Boolean
  delay_minutes   Int
  only_for_target Boolean
  

  role USER_ROLE?

  @@index([type])
}

model email_content {
  id Int @id @default(autoincrement())

  title   String @db.VarChar(255)
  content String @db.Text
  brief String @db.Text

  cc  user[] @relation("EmailCC")
  bcc user[] @relation("EmailBCC")

  email_recipient_state email_recipient_state[] @relation("email_recipient_state_content")
}

model email_recipient_state {
  id Int @id @default(autoincrement())

  userId Int
  user    user @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade, name: "Email_Recipient_state")

  email_contentId Int
  email_content    email_content @relation("email_recipient_state_content", fields: [email_contentId], references: [id])

  delay_minutes Int

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([userId, email_contentId])
}
