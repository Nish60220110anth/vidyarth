model student_cv {
  id          Int     @id @default(autoincrement())
  userId      Int
  domain      DOMAIN?
  cv_path     String  @db.Text
  cv_filename String
  version     Int
  is_primary  Boolean
  comment     String? @db.Text
  user        user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "student_cv_userId_fkey")
}
