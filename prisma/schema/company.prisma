model company {
  id               Int                    @id @default(autoincrement())
  company_name     String                 @unique
  company_full     String                 @db.VarChar(255)
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  is_featured      Boolean                @default(false)
  is_legacy        Boolean                @default(false)
  logo_url         String?                @db.Text
  firebase_path    String?
  alum_experiences company_alum_exp[]
  compendium       company_compendium?
  info             company_info?
  jds              company_jd[]
  domains          companydomainmapping[]
  news             news_company[]
  notifications    notification[]
  shortlists       shortlist[]
  summary          summary?               @relation("SummaryCompany")
  usersession      usersession[]
  videos           video[]
}

model companydomainmapping {
  id         Int     @id @default(autoincrement())
  company_id Int
  domain     DOMAIN
  company    company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, domain])
}

model company_info {
  id            Int     @id @default(autoincrement())
  company_id    Int     @unique
  brief_content String
  company       company @relation(fields: [company_id], references: [id], onDelete: Cascade)
}
