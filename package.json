{
  "name": "charon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "// ───────── Dev workflows ─────────": "",
    "dev": "cross-env NODE_ENV=development dotenv -e .env.development -- next dev -p 3000 -H localhost",
    "env:print:dev": "dotenv -e .env.development -- node -e \"console.log('NODE_ENV=', process.env.NODE_ENV); console.log('DATABASE_URL=', process.env.DATABASE_URL || 'missing')\"",
    "// ───────── Prisma (no migrate; generate + push only) ─────────": "",
    "db:gen:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- prisma generate",
    "db:push:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- prisma db push",
    "db:gen:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- prisma generate",
    "db:push:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- prisma db push",
    "// ───────── Build & start (production) ─────────": "",
    "build:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- next build",
    "serve:prod": "cross-env NODE_ENV=production dotenv -e .env.production -- next start -p 3000 -H localhost",
    "start:dev": "cross-env NODE_ENV=development dotenv -e .env.development -- next start -p 3000 -H localhost",
    "// IMPORTANT: app:prod is start-only (safe for PM2 cluster) ────": "",
    "app:prod": "npm run serve:prod",
    "// ───────── One-shot deploy helpers ─────────": "",
    "deploy:prod": "npm run db:gen:prod && npm run build:prod && npm run pm2:reload || npm run pm2:start",
    "// ───────── PM2 helpers (use one of these depending on your file) ─────────": "",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:start:ts": "pm2 start ecosystem.config.ts --env production --node-args='-r ts-node/register/transpile-only'",
    "pm2:reload": "pm2 reload charon",
    "pm2:restart": "pm2 restart charon",
    "pm2:stop": "pm2 stop charon && pm2 delete charon",
    "pm2:logs": "pm2 logs charon",
    "pm2:save": "pm2 save && pm2 startup",
    "// ───────── Utilities ─────────": "",
    "clean": "rimraf .next",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "env:print:prod": "dotenv -e .env.production -- node -e \"console.log('NODE_ENV=', process.env.NODE_ENV); console.log('DATABASE_URL=', process.env.DATABASE_URL || 'missing')\"",
    "// ───────── Postinstall ─────────": "",
    "postinstall": "npm run db:gen:prod",
    "analyze": "cross-env ANALYZE=true npm run build:prod",
    "prisma:generate":"cross-env NODE_ENV=production npx prisma generate && npx prisma db push"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@lexical/code": "0.33.1",
    "@lexical/headless": "0.33.1",
    "@lexical/html": "0.33.1",
    "@lexical/link": "0.33.1",
    "@lexical/list": "0.33.1",
    "@lexical/mark": "^0.33.1",
    "@lexical/react": "^0.33.1",
    "@lexical/rich-text": "0.33.1",
    "@lexical/table": "0.33.1",
    "@prisma/client": "^6.12.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-oauth/google": "^0.12.2",
    "@webiny/lexical-converter": "^5.43.2",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase-admin": "^13.4.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.18.1",
    "ioredis": "^5.6.1",
    "iron-session": "^8.0.4",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lexical": "0.33.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.536.0",
    "next": "15.3.3",
    "nodemailer": "^7.0.5",
    "prisma": "^6.12.0",
    "rate-limiter-flexible": "^7.1.1",
    "react": "^19.0.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-color": "^2.19.3",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-window": "^1.8.11",
    "resend": "^4.6.0",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/file-saver": "^2.0.7",
    "@types/formidable": "^3.4.5",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "./prisma/schema"
  }
}